<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="NksTriggerPadsPage" parent="ScNavigationPage">
    <property name="title" translatable="yes">TriggerPads</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top"><object class="AdwHeaderBar"/></child>
        <property name="content">
          <object class="ScPreferencesPage">

            <child>
              <object class="AdwPreferencesGroup">

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Trigger pad 1</property>
                    <property name="control-id-offset">0x20</property>
                    <property name="target-page">NksTriggerPadPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Trigger pad 2</property>
                    <property name="control-id-offset">0x28</property>
                    <property name="target-page">NksTriggerPadPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Trigger pad 3</property>
                    <property name="control-id-offset">0x30</property>
                    <property name="target-page">NksTriggerPadPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Trigger pad 4</property>
                    <property name="control-id-offset">0x38</property>
                    <property name="target-page">NksTriggerPadPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup">

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Trigger pad 5</property>
                    <property name="control-id-offset">0x40</property>
                    <property name="target-page">NksTriggerPadPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Trigger pad 6</property>
                    <property name="control-id-offset">0x48</property>
                    <property name="target-page">NksTriggerPadPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Trigger pad 7</property>
                    <property name="control-id-offset">0x50</property>
                    <property name="target-page">NksTriggerPadPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Trigger pad 8</property>
                    <property name="control-id-offset">0x58</property>
                    <property name="target-page">NksTriggerPadPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>
      </object>
    </property>

  </template>
</interface>
