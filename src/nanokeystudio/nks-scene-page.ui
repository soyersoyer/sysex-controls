<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="NksScenePage" parent="KorgScenePage">
    <property name="title" translatable="yes">Scene</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top"><object class="AdwHeaderBar"/></child>
        <property name="content">
          <object class="ScPreferencesPage">

            <child>
              <object class="AdwPreferencesGroup">

                <child>
                  <object class="AdwEntryRow">
                    <child>
                      <object class="MmControl">
                        <property name="id">0x00</property>
                        <property name="size">11</property>
                      </object>
                    </child>
                    <property name="title" translatable="yes">Name</property>
                    <property name="show-apply-button">yes</property>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup">

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Keyboard</property>
                    <property name="target-page">NksSceneKeyboardPage</property>
                    <property name="control-id-offset">0x10</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Chord Pad</property>
                    <property name="target-page">NksSceneChordPadPage</property>
                    <property name="control-id-offset">0x60</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Knobs</property>
                    <property name="target-page">NksKnobsPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Trigger Pads</property>
                    <property name="target-page">NksTriggerPadsPage</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Touch Scale</property>
                    <property name="target-page">NksTouchScalePage</property>
                    <property name="control-id-offset">0xc0</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Touch X / Y</property>
                    <property name="target-page">NksTouchXyPage</property>
                    <property name="control-id-offset">0xa8</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Touch Pitch / Mod</property>
                    <property name="target-page">NksTouchPitchModPage</property>
                    <property name="control-id-offset">0xb8</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

                <child>
                  <object class="ScActionRow">
                    <property name="title" translatable="yes">Sustain Button</property>
                    <property name="target-page">NksButtonPage</property>
                    <property name="control-id-offset">0xc8</property>
                    <signal name="activated" handler="sc_action_nav_push"/>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
