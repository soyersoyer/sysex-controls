<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="4.0"/>
    <requires lib="libadwaita" version="1.0"/>
    <template class="MatrChannelsPage" parent="ScNavigationPage">
        <property name="title" translatable="yes">Track Channels</property>
        <property name="child">
            <object class="AdwToolbarView">
                <child type="top"><object class="AdwHeaderBar"/></child>
                <property name="content">
                    <object class="ScPreferencesPage">

                        <child>
                            <object class="AdwPreferencesGroup">

                                <child>
                                    <object class="ScChRow">
                                        <child><object class="ArControl"><property name="id">0x410a</property></object></child>
                                        <property name="title" translatable="yes">MIDI IN Channel</property>
                                    </object>
                                </child>

                                <child>
                                    <object class="ScChRow">
                                        <child><object class="ArControl"><property name="id">0x410b</property></object></child>
                                        <property name="title" translatable="yes">MIDI OUT Channel</property>
                                    </object>
                                </child>

                            </object>
                        </child>


                    </object>
                </property>
            </object>
        </property>

    </template>
</interface>
